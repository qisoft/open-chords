{
  "name": "open-chords",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first desktop foundation for Open Chords",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "pnpm run build:renderer && pnpm run build:main && pnpm run build:preload",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "contracts:schema": "node tools/generate-contract-schema.ts",
    "contracts:schema:check": "node tools/generate-contract-schema.ts --check",
    "electron:install": "install-electron",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "start": "pnpm build && electron .",
    "test": "pnpm build && vitest run",
    "test:fixtures": "node tools/validate-contract-fixtures.ts",
    "test:packaged": "playwright test tests/packaged",
    "test:python": "node tools/run-python.ts sidecar/open_chords_analysis/validate_contract_fixtures.py",
    "test:renderer": "pnpm electron:install && pnpm build && playwright test tests/renderer",
    "test:unit": "vitest run",
    "typecheck": "tsc -b",
    "validate": "pnpm contracts:schema:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:fixtures && pnpm test:python && pnpm test:renderer"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "effect": "3.22.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@open-chords/contracts": "workspace:*",
    "@open-chords/domain": "workspace:*",
    "@open-chords/testkit": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "electron": "43.4.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "productName": "Open Chords"
}
