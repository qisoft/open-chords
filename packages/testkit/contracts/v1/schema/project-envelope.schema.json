            }
          },
          "required": [
            "barId",
            "meter",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "atSample": {
              "$ref": "#/$defs/PositiveSampleFrame"
            },
            "barId": {
              "$ref": "#/$defs/StableId"
            },
            "leftStatus": {
              "$ref": "#/$defs/BarStatus"
            },
            "newBarId": {
              "$ref": "#/$defs/StableId"
            },
            "newDownbeatId": {
              "$ref": "#/$defs/StableId"
            },
            "rightMeter": {
              "$ref": "#/$defs/Meter"
            },
            "rightStatus": {
              "$ref": "#/$defs/BarStatus"
            },
            "type": {
              "const": "split_bar",
              "type": "string"
            }
          },
          "required": [
            "atSample",
            "barId",
            "leftStatus",
            "newBarId",
            "newDownbeatId",
            "rightMeter",
            "rightStatus",
