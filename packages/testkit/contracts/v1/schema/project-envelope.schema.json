            }
          },
          "required": [
            "leftBarId",
            "meter",
            "rightBarId",
            "status",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alignmentId": {
              "$ref": "#/$defs/StableId"
            },
            "timing": {
              "$ref": "#/$defs/UserLyricsTiming"
