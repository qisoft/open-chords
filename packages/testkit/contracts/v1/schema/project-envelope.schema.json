        "text": {
          "type": "string"
        },
        "tokenization": {
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "scheme",
            "version"
          ],
          "type": "object"
        },
        "tokens": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "endOffset": {
                "$ref": "#/$defs/TextOffset"
              },
              "id": {
                "$ref": "#/$defs/StableId"
              },
              "lineId": {
                "$ref": "#/$defs/StableId"
              },
              "startOffset": {
                "$ref": "#/$defs/TextOffset"
