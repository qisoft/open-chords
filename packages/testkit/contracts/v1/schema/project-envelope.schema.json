          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "leftBarId": {
              "$ref": "#/$defs/StableId"
            },
            "meter": {
              "$ref": "#/$defs/Meter"
            },
            "rightBarId": {
              "$ref": "#/$defs/StableId"
            },
            "status": {
              "$ref": "#/$defs/BarStatus"
            },
            "type": {
              "const": "merge_bars",
