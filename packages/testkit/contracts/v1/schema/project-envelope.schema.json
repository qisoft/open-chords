      "required": [
        "analysisRevisionId",
        "id",
        "lineOccurrences",
        "lyricsDocumentId",
        "occurrences"
      ],
      "type": "object"
    },
    "LyricsDocument": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "language": {
          "minLength": 2,
          "type": "string"
        },
        "lines": {
          "items": {
            "additionalProperties": false,
