              }
            },
            "required": [
              "endOffset",
              "id",
              "lineId",
              "startOffset",
              "text"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "attribution",
        "id",
        "language",
        "lines",
        "notices",
        "provenance",
        "suppliedTimingKind",
        "text",
        "tokenization",
        "tokens"
      ],
      "type": "object"
    },
    "LyricsTiming": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "$ref": "#/$defs/AlignedAssertion"
            },
            "endSample": {
              "$ref": "#/$defs/PositiveSampleFrame"
            },
            "startSample": {
              "$ref": "#/$defs/SampleFrame"
            },
            "state": {
              "const": "matched",
              "type": "string"
