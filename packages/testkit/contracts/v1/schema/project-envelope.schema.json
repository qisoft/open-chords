            "alignmentId": {
              "$ref": "#/$defs/StableId"
            },
            "lineId": {
              "$ref": "#/$defs/StableId"
            },
            "timing": {
              "$ref": "#/$defs/UserLyricsTiming"
            },
            "type": {
              "const": "set_lyrics_line_timing",
