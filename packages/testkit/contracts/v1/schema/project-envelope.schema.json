{
  "$defs": {
    "ActiveView": {
      "additionalProperties": false,
      "properties": {
        "analysisRevisionId": {
          "$ref": "#/$defs/StableId"
        },
        "editHistoryPosition": {
          "$ref": "#/$defs/HistoryPosition"
        },
        "editLayerId": {
          "$ref": "#/$defs/StableId"
        },
        "lyricsAlignmentId": {
          "$ref": "#/$defs/StableId"
        },
        "lyricsDocumentId": {
          "$ref": "#/$defs/StableId"
        },
        "presentation": {
          "additionalProperties": false,
          "properties": {
            "beginnerView": {
              "type": "boolean"
            },
            "enharmonicPreference": {
              "enum": [
                "sharp",
                "flat",
                "contextual"
              ],
              "type": "string"
            },
            "transposeSemitones": {
              "maximum": 11,
              "minimum": -11,
              "type": "integer"
            }
          },
          "required": [
            "beginnerView",
            "enharmonicPreference",
            "transposeSemitones"
          ],
          "type": "object"
        }
      },
      "required": [
        "analysisRevisionId",
        "editHistoryPosition",
        "editLayerId",
        "presentation"
      ],
      "type": "object"
    },
    "AlignedAssertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            "reasonCodes": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "const": "asserted",
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "reasonCodes",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            "reasonCodes": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "const": "low_confidence",
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "reasonCodes",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "AnalysisRevision": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "manifestHash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/StableId"
        },
        "supportClaimIds": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "timeline": {
          "$ref": "#/$defs/MusicalTimeline"
        }
      },
      "required": [
        "createdAt",
        "id",
        "manifestHash",
        "projectId",
        "supportClaimIds",
        "timeline"
      ],
      "type": "object"
    },
    "Assertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            "reasonCodes": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "const": "asserted",
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "reasonCodes",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            "reasonCodes": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "const": "low_confidence",
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "reasonCodes",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            "reasonCodes": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "state": {
              "const": "abstained",
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "reasonCodes",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Bar": {
      "additionalProperties": false,
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "minItems": 1,
          "type": "array"
        },
        "endSample": {
          "$ref": "#/$defs/PositiveSampleFrame"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "meter": {
          "$ref": "#/$defs/Meter"
        },
        "startSample": {
          "$ref": "#/$defs/SampleFrame"
        },
        "status": {
          "$ref": "#/$defs/BarStatus"
        }
      },
      "required": [
        "endSample",
        "startSample",
        "beats",
        "id",
        "meter",
        "status"
      ],
      "type": "object"
    },
    "BarStatus": {
      "enum": [
        "complete",
        "pickup",
        "truncated"
      ],
      "type": "string"
    },
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "atSample": {
          "$ref": "#/$defs/SampleFrame"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "role": {
          "enum": [
            "downbeat",
            "beat"
          ],
          "type": "string"
        }
      },
      "required": [
        "atSample",
        "id",
        "role"
      ],
      "type": "object"
    },
    "ChordEvent": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "endSample": {
          "$ref": "#/$defs/PositiveSampleFrame"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "startSample": {
          "$ref": "#/$defs/SampleFrame"
        },
        "value": {
          "$ref": "#/$defs/ChordValue"
        }
      },
      "required": [
        "endSample",
        "startSample",
        "assertion",
        "id",
        "value"
      ],
      "type": "object"
    },
    "ChordIdentity": {
      "additionalProperties": false,
      "properties": {
        "additions": {
          "items": {
            "pattern": "^add(?:2|4|6|9|11|13)$",
            "type": "string"
          },
          "type": "array"
        },
        "alterations": {
          "items": {
            "pattern": "^(?:b|#)(?:5|9|11|13)$",
            "type": "string"
          },
          "type": "array"
        },
        "bass": {
          "$ref": "#/$defs/PitchClass"
        },
        "extensions": {
          "items": {
            "enum": [
              "6",
              "7",
              "9",
              "11",
              "13"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "const": "chord",
          "type": "string"
        },
        "omissions": {
          "items": {
            "pattern": "^no(?:3|5)$",
            "type": "string"
          },
          "type": "array"
        },
        "quality": {
          "enum": [
            "major",
            "minor",
            "diminished",
            "augmented",
            "sus2",
            "sus4",
            "major7",
            "minor7",
            "diminished7",
            "half_diminished"
          ],
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/PitchClass"
        }
      },
      "required": [
        "additions",
        "alterations",
        "extensions",
        "kind",
        "omissions",
        "quality",
        "root"
      ],
      "type": "object"
    },
    "ChordValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/ChordIdentity"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "no_chord",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "EditLayer": {
      "additionalProperties": false,
      "properties": {
        "analysisRevisionId": {
          "$ref": "#/$defs/StableId"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "transactions": {
