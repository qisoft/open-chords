function run(argv) {
  var applicationPid = Number(argv[0]);
  var scenario = argv[1] || 'cancel';
  var expandedControls = scenario === 'cancel_save_edited_expanded';
  var preparesExpandedDirectory = scenario === 'prepare_save_directory_expanded';
  var preparesDirectory = scenario === 'prepare_save_directory' || preparesExpandedDirectory;
  var directoryScenario = scenario === 'cancel_save_directory' || preparesDirectory;
  var selectedPath = directoryScenario ? argv[3] : argv[2];
  var selectsFile = scenario === 'open' || scenario === 'cancel_open_existing';
  var saves = expandedControls || scenario === 'cancel_save' || scenario === 'cancel_save_edited' || directoryScenario;
  var editsFilename = expandedControls || scenario === 'cancel_save_edited' || directoryScenario;
  var primaryAction = saves ? 'Save' : 'Open';
  var saveDefaults = { json: 'Open Chords.json', lrc: 'Open Chords.lrc', chordpro: 'Open Chords.cho', pdf: 'Open Chords.pdf', archive: 'Open Chords.ocarchive' };
  var saveFormat = saves ? argv[2] : null;
  if (saves && !Object.prototype.hasOwnProperty.call(saveDefaults, saveFormat)) throw new Error('Invalid native picker driver arguments');
  if (['cancel', 'cancel_save', 'cancel_save_edited', 'cancel_save_edited_expanded', 'cancel_save_directory', 'prepare_save_directory', 'prepare_save_directory_expanded', 'open', 'cancel_open_existing'].indexOf(scenario) === -1 ||
      ((selectsFile || directoryScenario) && (typeof selectedPath !== 'string' || selectedPath[0] !== '/' || selectedPath.indexOf('\n') !== -1 || selectedPath.indexOf('\r') !== -1))) {
    throw new Error('Invalid native picker driver arguments');
  }
  if (!Number.isInteger(applicationPid) || applicationPid <= 0) {
    throw new Error('Invalid native picker driver arguments');
  }
  var systemEvents = Application('System Events');
  var started = Date.now();
  var deadline = started + 90000;
  var stage = 'processes';
  var selectionStep = 'none';
  var discoveryRefreshes = 0;
  var referenceRefreshes = 0;
  var nativeInputStarted = false;
  var guardReading = false;
  var guardErrors = [];
  var attributeFailures = [];
  var counts = { processes: 0, windows: 0, sheets: 0, elements: 0, cancel: 0, open: 0, navigation_sheets: 0, path_fields: 0, selected_rows: 0, selected_urls: 0, selected_matches: 0 };
  function attribute(element, name) {
    try { return element[name](); }
    catch (error) {
      var number = error && error.errorNumber;
      if (!Number.isInteger(number) || number < -32768 || number > 32767) number = 'unknown';
      if (guardReading) guardErrors.push(number);
      attributeFailures.push('Native macOS picker attribute: stage=' + stage + ' attribute=' + name + ' os_error=' + number);
      if (attributeFailures.length > 3) attributeFailures.shift();
      return null;
    }
  }
  function reportGuardSnapshot(process, candidate, phase) {
    var status = 'complete', windows = 0, sheets = 0, osError = 'none';
    var sheetExists = 'unknown', buttonExists = 'unknown';
    function existence(element) {
      try {
        var value = element.exists();
        return value === true ? 'true' : value === false ? 'false' : 'unknown';
      } catch (error) {
        status = 'error';
        osError = error && Number.isInteger(error.errorNumber) && error.errorNumber >= -32768 && error.errorNumber <= 32767 ? error.errorNumber : 'unknown';
        return 'unknown';
      }
    }
    try {
      if (Date.now() >= deadline) status = 'deadline';
      else {
        sheetExists = existence(candidate.sheet);
        buttonExists = existence(candidate.button);
        var currentWindows = process.windows();
        windows = Math.min(currentWindows.length, 17);
        if (windows > 16) { if (status === 'complete') status = 'bound'; }
        else for (var w = 0; w < currentWindows.length; w++) {
          if (Date.now() >= deadline) { if (status === 'complete') status = 'deadline'; break; }
          sheets = Math.min(17, sheets + currentWindows[w].sheets().length);
          if (sheets > 16) { if (status === 'complete') status = 'bound'; break; }
        }
      }
    } catch (error) {
      status = 'error';
      osError = error && Number.isInteger(error.errorNumber) && error.errorNumber >= -32768 && error.errorNumber <= 32767 ? error.errorNumber : 'unknown';
    }
    console.log('Native macOS picker guard snapshot: phase=' + phase + ' status=' + status +
      ' age_ms=' + Math.max(0, Math.min(200000, Date.now() - candidate.capturedAt)) +
      ' sheet_exists=' + sheetExists + ' button_exists=' + buttonExists +
      ' windows=' + windows + ' sheets=' + sheets + ' os_error=' + osError);
    return status === 'complete' && sheetExists === 'false' && buttonExists === 'false' && windows === 1 && sheets === 1;
  }
  function requireCancelTarget(process, candidate, phase, includePrimary) {
    guardReading = true;
    guardErrors = [];
    var values = [attribute(process, 'unixId'), attribute(process, 'frontmost'), attribute(candidate.sheet, 'role'),
      attribute(candidate.button, 'role'), attribute(candidate.button, 'name'), attribute(candidate.button, 'enabled'),
      includePrimary ? attribute(candidate.open, 'name') : primaryAction, Date.now() < deadline];
    guardReading = false;
    var expected = [applicationPid, true, 'AXSheet', 'AXButton', 'Cancel', true, primaryAction, true];
    var mask = 0;
    var unknownMask = 0;
    for (var i = 0; i < values.length; i++) {
      if (values[i] === expected[i]) mask |= (1 << i);
      if (values[i] === null) unknownMask |= (1 << i);
    }
    if (mask !== 255) {
      console.log('Native macOS picker guard: phase=' + phase + ' mask=' + mask + ' unknown_mask=' + unknownMask);
      var staleReferences = reportGuardSnapshot(process, candidate, phase);
      if (saves && !nativeInputStarted && referenceRefreshes === 0 && (mask & 3) === 3 &&
          (unknownMask & ~124) === 0 && guardErrors.length > 0 &&
          guardErrors.every(function (number) { return number === -1728; }) && staleReferences)
        throw new Error('stale before input');
      throw new Error('action target changed');
    }
  }

  function prepareNavigation(process, candidate, navigationPath) {
    requireCancelTarget(process, candidate, 'before_input', true);
    stage = 'navigation';
    nativeInputStarted = true;
    systemEvents.keystroke('g', { using: ['command down', 'shift down'] });
    var navigationDeadline = Math.min(deadline, Date.now() + 5000);
    var entry = null;
    while (Date.now() < navigationDeadline) {
      var nested = candidate.sheet.sheets();
      counts.navigation_sheets = Math.min(nested.length, 17);
      if (nested.length > 1) throw new Error('ambiguous navigation sheet');
      if (nested.length === 1 && attribute(nested[0], 'role') === 'AXSheet') {
        var navigationElements = nested[0].entireContents();
        if (navigationElements.length > 256) throw new Error('navigation bound');
        var fields = [];
        for (var n = 0; n < navigationElements.length; n++) {
          var role = attribute(navigationElements[n], 'role');
          if ((role === 'AXTextField' || role === 'AXComboBox') && attribute(navigationElements[n], 'enabled') === true) fields.push(navigationElements[n]);
        }
        counts.path_fields = Math.min(fields.length, 257);
        if (fields.length > 1) throw new Error('ambiguous path field');
        if (fields.length === 1) { entry = fields[0]; break; }
      }
      delay(0.05);
    }
    if (!entry || attribute(process, 'unixId') !== applicationPid || attribute(process, 'frontmost') !== true) throw new Error('path entry unavailable');
    stage = 'path_entry';
    entry.focused = true;
    while (Date.now() < navigationDeadline && attribute(entry, 'focused') !== true) delay(0.05);
    if (Date.now() >= navigationDeadline || attribute(entry, 'focused') !== true || attribute(entry, 'enabled') !== true ||
        attribute(process, 'frontmost') !== true || attribute(process, 'unixId') !== applicationPid) throw new Error('path focus failed');
    systemEvents.keystroke('a', { using: ['command down'] });
    if (attribute(entry, 'focused') !== true || attribute(process, 'frontmost') !== true || attribute(process, 'unixId') !== applicationPid) throw new Error('path focus changed');
    systemEvents.keystroke(navigationPath);
    while (Date.now() < navigationDeadline && attribute(entry, 'value') !== navigationPath) delay(0.05);
    if (attribute(entry, 'value') !== navigationPath || attribute(entry, 'focused') !== true ||
        attribute(process, 'frontmost') !== true || attribute(process, 'unixId') !== applicationPid) throw new Error('path readback failed');
    systemEvents.keyCode(36);
    stage = 'navigation_dismissal';
    var navigationDismissed = false;
    while (Date.now() < navigationDeadline) {
      if (attribute(candidate.sheet, 'role') !== 'AXSheet' || attribute(process, 'unixId') !== applicationPid || attribute(process, 'frontmost') !== true) throw new Error('navigation parent changed');
      var remainingSheets = candidate.sheet.sheets();
      counts.navigation_sheets = Math.min(remainingSheets.length, 17);
      if (remainingSheets.length > 1) throw new Error('ambiguous navigation sheet');
      if (remainingSheets.length === 0) { navigationDismissed = true; break; }
      // The child can disappear between collection and role reads. Only the
      // next positive empty collection proves dismissal; an unreadable child does not.
      var navigationRole = attribute(remainingSheets[0], 'role');
      if (navigationRole !== null && navigationRole !== 'AXSheet') throw new Error('navigation role changed');
      delay(0.05);
    }
    if (!navigationDismissed) throw new Error('navigation not dismissed');
    if (Date.now() >= deadline || attribute(process, 'unixId') !== applicationPid || attribute(process, 'frontmost') !== true ||
        attribute(candidate.sheet, 'role') !== 'AXSheet' || attribute(candidate.button, 'name') !== 'Cancel' ||
        attribute(candidate.open, 'name') !== primaryAction) throw new Error('prepared target changed');
  }

  function expandedSaveControls(sheet) {
    var queue = [sheet], elements = [], skipped = 0, complete = false;
    try {
      while (queue.length > 0) {
        if (Date.now() >= deadline) throw new Error('deadline');
        if (elements.length >= 256 || queue.length > 256) throw new Error('element bound');
        var element = queue.shift();
        elements.push(element);
        var role = attribute(element, 'role');
        if (role === null) throw new Error('save control role unavailable');
        // File-browser descendants are not dialog action or Save As controls.
        if (['AXBrowser', 'AXList', 'AXOutline', 'AXTable', 'AXColumn', 'AXRow', 'AXCell', 'AXWebArea'].indexOf(role) !== -1) {
          skipped++;
          continue;
        }
        var children = element.uiElements();
        if (children.length > 256 || queue.length + children.length > 256) throw new Error('element bound');
        queue = queue.concat(children);
      }
      complete = true;
      return elements;
    } finally {
      console.log('Native macOS Save controls probe: elements=' + Math.min(elements.length, 256) +
        ' skipped_content=' + Math.min(skipped, 256) + ' complete=' + complete);
    }
  }

  function verifyDefaultFilename(saveFormat, saveElements) {
    var fields = [];
    var filenameFields = [];
    var total = 0;
    var unreadableRoles = 0;
    var unreadableGone = 0, unreadableLive = 0, unreadableUnknown = 0;
    var expectedFilename = saveDefaults[saveFormat];
    var basename = expectedFilename.slice(0, expectedFilename.lastIndexOf('.'));
    for (var f = 0; f < saveElements.length; f++) {
      var field = saveElements[f];
      var fieldRole = attribute(field, 'role');
      if (fieldRole === null) {
        unreadableRoles++;
        try {
          var exists = field.exists();
          if (exists === false) unreadableGone++;
          else if (exists === true) unreadableLive++;
          else unreadableUnknown++;
        } catch (_) { unreadableUnknown++; }
      }
      if (fieldRole !== 'AXTextField' && fieldRole !== 'AXComboBox') continue;
      // Expanded browser search is not a filename input; all other fields remain checked.
      if (expandedControls && fieldRole === 'AXTextField' && attribute(field, 'subrole') === 'AXSearchField') continue;
      total++;
      if (fields.length === 16) continue;
      var fieldName = attribute(field, 'name');
      if (fieldName === 'Save As:' || fieldName === 'Save As') filenameFields.push(field);
      var fieldValue = attribute(field, 'value');
      var subrole = attribute(field, 'subrole');
      var enabled = attribute(field, 'enabled');
      fields.push({
        role: fieldRole === 'AXTextField' ? 'text_field' : 'combo',
        subrole: subrole === 'AXSearchField' ? 'search' : subrole === '' ? 'empty' : subrole === null ? 'unavailable' : 'other',
        name: fieldName === 'Save As:' || fieldName === 'Save As' ? 'save_as' : fieldName === '' ? 'empty' : fieldName === null ? 'unavailable' : 'other',
        value: fieldValue === expectedFilename ? 'expected' : fieldValue === basename ? 'basename' : fieldValue === '' ? 'empty' : typeof fieldValue === 'string' ? 'other' : 'unavailable',
        enabled: enabled === true ? 'true' : enabled === false ? 'false' : 'unknown'
      });
    }
    var saveProbe = { format: saveFormat, total: total, unreadableRoles: unreadableRoles, truncated: total > 16, fields: fields };
    console.log('Native macOS Save field evidence: ' + JSON.stringify(saveProbe));
    if (unreadableRoles > 0) console.log('Native macOS Save unreadable references: total=' + unreadableRoles +
      ' gone=' + unreadableGone + ' live=' + unreadableLive + ' unknown=' + unreadableUnknown);
    if (unreadableRoles !== 0 || total > 16 || fields.some(function (field) { return field.name === 'unavailable'; }) || filenameFields.length !== 1) throw new Error('default filename unavailable');
    var filenameField = filenameFields[0];
    var filenameName = attribute(filenameField, 'name');
    if (attribute(filenameField, 'role') !== 'AXTextField' ||
        (filenameName !== 'Save As:' && filenameName !== 'Save As') ||
        attribute(filenameField, 'enabled') !== true || attribute(filenameField, 'value') !== expectedFilename) throw new Error('default filename invalid');
    return { probe: saveProbe, field: filenameField };
  }

  try {
    discovery: while (Date.now() < deadline) {
      try {
      stage = 'processes';
      var processes = systemEvents.processes.whose({ unixId: applicationPid })();
      counts.processes = Math.min(processes.length, 17);
      if (processes.length === 0) { delay(0.1); continue; }
      if (processes.length !== 1) throw new Error('ambiguous');
      var process = processes[0];
      stage = 'windows';
      var windows = process.windows();
      counts.windows = Math.min(windows.length, 17);
      if (windows.length > 16) throw new Error('window bound');
      var candidates = [];
      counts.sheets = 0;
      for (var w = 0; w < windows.length; w++) {
        stage = 'sheets';
        var sheets;
        try { sheets = windows[w].sheets(); }
        catch (error) {
          // A disappearing discovery window must be reacquired before any input.
          if (error.errorNumber !== -1728 || discoveryRefreshes >= 3) throw error;
          discoveryRefreshes++;
          delay(0.1);
          continue discovery;
        }
        counts.sheets += sheets.length;
        if (counts.sheets > 16) { counts.sheets = 17; throw new Error('sheet bound'); }
        for (var s = 0; s < sheets.length; s++) {
          if (attribute(sheets[s], 'role') !== 'AXSheet') continue;
          stage = 'elements';
          var elements = expandedControls ? expandedSaveControls(sheets[s]) : sheets[s].entireContents();
          counts.elements = Math.min(elements.length, 257);
          if (elements.length > 256) {
            if (preparesExpandedDirectory) {
              var controls = expandedSaveControls(sheets[s]);
              var disclosures = 0, zero = 0, one = 0, unknown = 0;
              for (var d = 0; d < controls.length; d++) {
                if (attribute(controls[d], 'role') !== 'AXDisclosureTriangle') continue;
                disclosures++;
                var disclosureValue = attribute(controls[d], 'value');
                if (disclosureValue === 0 || disclosureValue === '0') zero++;
                else if (disclosureValue === 1 || disclosureValue === '1') one++;
                else unknown++;
              }
              console.log('Native macOS Save initial disclosure: controls=' + controls.length +
                ' disclosures=' + disclosures + ' zero=' + zero + ' one=' + one + ' unknown=' + unknown);
            }
            throw new Error('element bound');
          }
          var cancel = [];
          var open = [];
          for (var e = 0; e < elements.length; e++) {
            if (attribute(elements[e], 'role') !== 'AXButton') continue;
            var name = attribute(elements[e], 'name');
            if (name === 'Cancel' && attribute(elements[e], 'enabled') === true) cancel.push(elements[e]);
            if (name === primaryAction) open.push(elements[e]);
          }
          counts.cancel = cancel.length;
          counts.open = open.length;
          if (cancel.length === 1 && open.length === 1) candidates.push({ sheet: sheets[s], button: cancel[0], open: open[0], elements: elements, capturedAt: Date.now() });
        }
      }
      stage = 'selection';
      if (candidates.length > 1) throw new Error('ambiguous picker');
      if (candidates.length === 0) { delay(0.1); continue; }
      var candidate = candidates[0];
      stage = 'action';
      process.frontmost = true;
      var frontDeadline = Math.min(deadline, Date.now() + 2000);
      while (Date.now() < frontDeadline && attribute(process, 'frontmost') !== true) delay(0.05);
      requireCancelTarget(process, candidate, 'activate', false);
      if (selectsFile) {
        prepareNavigation(process, candidate, selectedPath);
        return JSON.stringify({ prepared: true, nativePress: false, navigationDismissed: true });
      }

      stage = 'action';
      requireCancelTarget(process, candidate, 'before_input', true);
      var saveProbe = null;
      if (saves) {
        var verifiedSave = verifyDefaultFilename(saveFormat, candidate.elements);
        saveProbe = verifiedSave.probe;
        var filenameField = verifiedSave.field;
        var expectedFilename = saveDefaults[saveFormat];
        if (directoryScenario) {
          prepareNavigation(process, candidate, selectedPath);
          stage = 'action';
          var refreshedSaveElements = candidate.sheet.entireContents();
          if (refreshedSaveElements.length > 256) throw new Error('element bound');
          verifiedSave = verifyDefaultFilename(saveFormat, refreshedSaveElements);
          filenameField = verifiedSave.field;
          saveProbe = verifiedSave.probe;
        }
      }
      if (saveProbe !== null) requireCancelTarget(process, candidate, 'after_probe', true);
      if (preparesDirectory) return JSON.stringify({ prepared: true, nativePress: false, navigationDismissed: true, directoryNavigationVerified: true, defaultFilenameVerified: true, saveFieldProbe: saveProbe });
      if (editsFilename) {
        var inputFilename = 'Cancelled ' + expectedFilename;
        var inputDeadline = Math.min(deadline, Date.now() + 5000);
        nativeInputStarted = true;
        filenameField.focused = true;
        while (Date.now() < inputDeadline && attribute(filenameField, 'focused') !== true) delay(0.05);
        requireCancelTarget(process, candidate, 'before_input', true);
        if (Date.now() >= inputDeadline || attribute(filenameField, 'focused') !== true || attribute(filenameField, 'enabled') !== true ||
            attribute(filenameField, 'role') !== 'AXTextField' || attribute(filenameField, 'value') !== expectedFilename) throw new Error('filename input focus failed');
        systemEvents.keystroke('a', { using: ['command down'] });
        requireCancelTarget(process, candidate, 'before_input', true);
        if (Date.now() >= inputDeadline || attribute(filenameField, 'focused') !== true || attribute(filenameField, 'enabled') !== true) throw new Error('filename input focus failed');
        systemEvents.keystroke(inputFilename);
        while (Date.now() < inputDeadline && attribute(filenameField, 'value') !== inputFilename) delay(0.05);
        if (Date.now() >= inputDeadline || attribute(filenameField, 'value') !== inputFilename ||
            attribute(filenameField, 'focused') !== true || attribute(filenameField, 'enabled') !== true ||
            attribute(filenameField, 'role') !== 'AXTextField') throw new Error('filename input readback failed');
        requireCancelTarget(process, candidate, 'after_probe', true);
      }
      nativeInputStarted = true;
      candidate.button.click();
      stage = 'dismissal';
      var dismissDeadline = Math.min(deadline, Date.now() + 2000);
      while (Date.now() < dismissDeadline) {
        if (candidate.sheet.exists() === false) {
          var result = { action: scenario, nativePress: true, dialogDismissed: true };
          if (saveProbe !== null) { result.saveFieldProbe = saveProbe; result.defaultFilenameVerified = true; result.filenameInputVerified = editsFilename; result.directoryNavigationVerified = directoryScenario; }
          return JSON.stringify(result);
        }
        delay(0.1);
      }
      throw new Error('not dismissed');
      } catch (error) {
        if (error && error.message === 'stale before input' && !nativeInputStarted && referenceRefreshes === 0 && Date.now() < deadline) {
          referenceRefreshes++;
          console.log('Native macOS picker refresh: reason=stale_reference attempt=1 before_input=true');
          continue discovery;
        }
        throw error;
      }
    }
    stage = 'deadline';
    throw new Error('deadline');
  } catch (error) {
    for (var a = 0; a < attributeFailures.length; a++) console.log(attributeFailures[a]);
    var reasons = { 'filename input focus failed': 'filename_input_focus_failed', 'filename input readback failed': 'filename_input_readback_failed', 'default filename unavailable': 'default_filename_unavailable', 'default filename invalid': 'default_filename_invalid', 'navigation parent changed': 'navigation_parent_changed', 'navigation role changed': 'navigation_role_changed', 'navigation not dismissed': 'navigation_not_dismissed', 'prepared target changed': 'prepared_target_changed', 'action target changed': 'action_target_changed' };
    var reason = error && Object.prototype.hasOwnProperty.call(reasons, error.message) ? reasons[error.message] : 'other';
    console.log('Native macOS picker refusal: reason=' + reason);
    var number = error && error.errorNumber;
    if (!Number.isInteger(number) || number < -32768 || number > 32767) number = 'unknown';
    console.log('Native macOS picker failure: stage=' + stage + ' elapsed_ms=' + Math.max(0, Math.min(200000, Date.now() - started)) +
      ' processes=' + counts.processes + ' windows=' + counts.windows + ' sheets=' + counts.sheets +
      ' elements=' + counts.elements + ' cancel=' + counts.cancel + ' open=' + counts.open +
      ' navigation_sheets=' + counts.navigation_sheets + ' path_fields=' + counts.path_fields +
      ' selected_rows=' + Math.min(counts.selected_rows, 257) + ' selected_urls=' + Math.min(counts.selected_urls, 999) +
      ' selected_matches=' + Math.min(counts.selected_matches, 999) + ' selection_step=' + selectionStep + ' os_error=' + number);
    throw new Error('Installed native macOS picker failed');
  }
}
