{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tooling.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "apps/desktop/src/renderer/committed-project-store.ts",
    "apps/desktop/src/renderer/**/*.d.ts",
    "apps/desktop/src/renderer/playback-clock.ts",
    "apps/desktop/src/renderer/workspace-playback.ts",
    "apps/desktop/src/renderer/workspace-timeline.ts",
    "apps/desktop/src/renderer/workspace-content.ts",
    "apps/desktop/src/renderer/workspace-geometry.ts",
    "packages/contracts/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "packages/testkit/src/**/*.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "vite.main.config.ts",
    "vitest.config.ts"
  ]
}
